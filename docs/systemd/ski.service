[Unit]
Description=SKI SSH certificate issuer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ski
Group=ski
WorkingDirectory=/var/lib/ski
Environment=HOME=/var/lib/ski
EnvironmentFile=-/etc/ski/env
ExecStart=/home/ski/.local/bin/ski serve
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
StateDirectory=ski
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/ski
ReadOnlyPaths=/etc/ski
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ski

[Install]
WantedBy=multi-user.target
