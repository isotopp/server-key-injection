[Unit]
Description=SKI SSH certificate issuer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ski
Group=ski
WorkingDirectory=/home/ski/var/lib/ski
Environment=HOME=/home/ski
EnvironmentFile=-/home/ski/etc/env
ExecStart=/home/ski/.local/bin/ski serve
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ski/var/lib/ski
ReadOnlyPaths=/home/ski/etc
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ski

[Install]
WantedBy=multi-user.target
